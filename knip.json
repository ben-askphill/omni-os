{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "swift",
    "flock",
    "scutil",
    "ioreg",
    "pgrep"
  ],
  "ignore": [
    ".claude/**",
    "docs/**",
    "prototypes/**",
    "mods/**",
    "**/fixtures/**",
    "apps/mac/OmniKit/Sources/OmniKit/Resources/*.js"
  ],
  "workspaces": {
    "apps/server": {
      "entry": [
        "scripts/*.ts",
        "scripts/route-eval/*.ts",
        "tests/**/*.test.ts"
      ],
      "ignoreDependencies": [
        "@playwright/mcp"
      ]
    },
    "apps/relay": {
      "entry": [
        "tests/**/*.test.ts"
      ],
      "ignoreDependencies": [
        "cloudflare"
      ]
    },
    "apps/mcp": {
      "entry": [
        "omni.ts",
        "ask.ts",
        "threads.ts",
        "external/stdio.ts"
      ]
    },
    "apps/ios": {
      "ignoreDependencies": [
        "@effect/atom-react",
        "effect",
        "expo-status-bar",
        "react-native-reanimated",
        "react-native-worklets",
        "babel-plugin-react-compiler",
        "expo-updates",
        "expo-system-ui"
      ]
    },
    "apps/web": {
      "entry": [
        "tests/**/*.test.ts"
      ]
    },
    "apps/linux": {
      "entry": [
        "src/main.ts",
        "tests/**/*.test.ts"
      ]
    },
    "apps/mac": {
      "entry": [
        "scripts/*.ts",
        "slash-engine/entry.ts",
        "browser-pick/entry.ts",
        "tests/**/*.test.ts"
      ],
      "ignoreDependencies": [
        "mermaid",
        "@omni/test-fixtures"
      ]
    },
    "packages/shared": {
      "entry": [
        "*.ts",
        "scripts/*.ts",
        "tests/**/*.test.ts"
      ]
    },
    "packages/test-fixtures": {
      "entry": [
        "*.{mjs,mts,ts}"
      ]
    }
  },
  "exclude": [
    "exports",
    "types",
    "duplicates"
  ]
}
