# All optional. Defaults shown.
# OMNI_PORT=4747
# OMNI_HOST=127.0.0.1
# OMNI_BRAIN_DIR=/Users/you/phillbert        default cwd + context for non-repo channels
# OMNI_CLAUDE_BIN=claude
# OMNI_DEFAULT_MODEL=claude-sonnet-5-5
# OMNI_PERMISSION_MODE=bypassPermissions     headless runs cannot answer prompts
# OMNI_MAX_CONCURRENT=4                      turns running at once; warm idle sessions do not count
# OMNI_MAX_CONCURRENT_HERMES=4              Hermes runs at once. Hermes also has its own server-side cap
# OMNI_HERMES_URL=http://100.110.128.38:8642  The Hermes API server's Tailscale address. It is not public; the Mac must be on the tailnet. The bearer token is the Keychain secret HERMES_API_KEY, not an env var.
# OMNI_KEEPALIVE_SECONDS=600                 keep a thread's claude process warm this long after a turn, 0 = close at once
# OMNI_INTERRUPT_GRACE_MS=8000               after Interrupt, kill the process if the turn has not ended by then
# OMNI_DATA_DIR=./data                        runtime state (db, threads, worktrees, browsers), relative to the repo
# OMNI_AUTOMATIONS_DIR=./automations         the automation YAML files, relative to the repo
# OMNI_BROWSER=1                             attach a Playwright MCP per thread
# OMNI_BROWSER_LIVE=1                        Omni runs each channel's Chrome itself, shown live in the thread's Browser panel
# OMNI_CHROME_BIN=                           Chrome to run (default: Google Chrome, else the newest Playwright Chromium)
# OMNI_MAX_UPLOAD_MB=25                      per-file cap for composer attachments
