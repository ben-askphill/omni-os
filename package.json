{
  "name": "omni-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One local workspace for Claude agent work: channels, threads, sandboxes, artifacts, PRs, conductor, automations.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "npm run start --workspace @omni/server",
    "test": "turbo boundaries && turbo run test",
    "test:mac": "turbo run test:mac",
    "test:all": "turbo boundaries && turbo run test test:mac",
    "typecheck": "turbo run typecheck",
    "import-history": "npm run import-history --workspace @omni/server --",
    "build:slash": "npm run build:slash --workspace @omni/mac",
    "sync:backfill": "npm run sync:backfill --workspace @omni/server --",
    "brain-export": "npm run brain-export --workspace @omni/server --",
    "setup": "npm run setup --workspace @omni/server --"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0"
    }
  },
  "devDependencies": {
    "turbo": "^2.11.9"
  }
}
