{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "globalEnv": ["OMNI_*"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "test:mac": {
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "boundaries": {
    "tags": {
      "lib": {
        "dependencies": { "deny": ["app"] }
      },
      "mac": {
        "dependencies": { "deny": ["@omni/web"] }
      },
      "web": {
        "dependencies": { "deny": ["@omni/mac"] }
      },
      "linux": {
        "dependencies": { "deny": ["@omni/web", "@omni/mac", "@omni/server"] }
      },
      "relay": {
        "dependencies": { "deny": ["@omni/web", "@omni/mac", "@omni/server", "@omni/shared", "@omni/mcp"] }
      },
      "ios": {
        "dependencies": { "deny": ["@omni/web", "@omni/mac", "@omni/server"] }
      },
      "desktop": {
        "dependencies": { "deny": ["@omni/web", "@omni/mac", "@omni/server", "@omni/linux", "@omni/mcp", "@omni/client-core"] }
      }
    }
  }
}
