{
  "acceptedDifferences": [
    {
      "name": "emphasis-around-url",
      "summary": "micromark finds a literal URL before it pairs *, _ and ~, so the web keeps the URL whole. cmark pairs those delimiters first, so a delimiter in the URL that pairs with one outside splits the URL on the Mac."
    },
    {
      "name": "amp-after-url",
      "summary": "cmark decodes &amp; before autolinking, so the Mac link takes the &. The web stops before the entity."
    },
    {
      "name": "unparsed-url",
      "summary": "A URL Foundation cannot parse (a port that is not a number, or no host) stays plain on the Mac. The web links it."
    },
    {
      "name": "thread-id-linking",
      "summary": "An id in <...> or _..._ is linked on the Mac and not on the web."
    },
    {
      "name": "relative-link",
      "summary": "A relative link is plain text on the Mac and a dead link on the web."
    }
  ],
