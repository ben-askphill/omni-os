    {
      "name": "arguments it refuses, without a request",
      "server": "memory",
      "env": {
        "OMNI_USER": "Ben",
        "OMNI_THREAD_ID": "thread-1",
        "OMNI_TOKEN": "tok-1",
        "OMNI_ROLE": "reviewer"
      },
      "steps": [
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
              "protocolVersion": "2025-06-18",
              "capabilities": {},
              "clientInfo": {
                "name": "scenario",
                "version": "0"
              }
            }
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "method": "notifications/initialized"
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "tools/call",
            "params": {
              "name": "remember",
              "arguments": {
                "text": ""
              }
            }
          }
        },
        {
          "waitResponse": 2
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "tools/call",
            "params": {
              "name": "remember",
              "arguments": {
                "text": ""
              }
            }
          }
        },
        {
          "waitResponse": 3
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 4,
            "method": "tools/call",
            "params": {
              "name": "remember",
              "arguments": {
                "text": "Run the repo's own check script before you report.",
                "everywhere": "yes"
              }
            }
          }
        },
        {
          "waitResponse": 4
        },
        {
          "send": {
            "jsonrpc": "2.0",
