{
  "scenarios": [
    {
      "name": "protocol: initialize and list the tool",
      "server": "memory",
      "env": {
        "OMNI_USER": "Ben",
        "OMNI_THREAD_ID": "thread-1",
        "OMNI_TOKEN": "tok-1",
        "OMNI_ROLE": "reviewer"
      },
      "steps": [
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
              "protocolVersion": "2025-06-18",
              "capabilities": {},
              "clientInfo": {
                "name": "scenario",
                "version": "0"
              }
            }
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "method": "notifications/initialized"
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "tools/list"
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "ping"
          }
        }
      ],
      "expected": {
        "responses": [
          {
            "result": {
              "protocolVersion": "2025-06-18",
              "capabilities": {
                "tools": {
                  "listChanged": true
                }
              },
              "serverInfo": {
                "name": "omni-memory",
                "version": "0.1.0"
              }
            },
            "jsonrpc": "2.0",
            "id": 1
          },
          {
            "result": {
              "tools": [
                {
                  "name": "remember",
                  "description": "Propose a lesson for this agent's later threads: a correction Ben made to how this agent works, or a step it missed that every later thread of it should take. One short sentence that still makes sense in a new thread, about how to work, never about this one task. Never put secrets, credentials or personal data in it. It holds in this channel only, unless you pass everywhere: true for a lesson about the agent that holds in every channel. It waits for Ben's approval in Settings > Agents, unless Ben lets this agent keep its lessons at once; the answer says which.",
                  "inputSchema": {
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500,
                        "description": "The lesson, in one short sentence."
                      },
                      "everywhere": {
                        "description": "true: for this agent in every channel. Leave it out for this channel only.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "text"
                    ]
                  },
                  "execution": {
                    "taskSupport": "forbidden"
                  }
                }
              ]
            },
            "jsonrpc": "2.0",
            "id": 2
          },
          {
            "result": {},
            "jsonrpc": "2.0",
            "id": 3
          }
        ],
        "requests": [],
        "exit": 0
      }
    },
    {
      "name": "a lesson for this channel waits for the user, and one for every channel the user lets the role keep",
      "server": "memory",
      "env": {
        "OMNI_USER": "Ben",
        "OMNI_THREAD_ID": "thread-1",
        "OMNI_TOKEN": "tok-1",
        "OMNI_ROLE": "reviewer"
      },
      "api": [
        {
          "status": 201,
          "json": {
            "id": "m1",
            "channel_id": "acme",
            "role": "reviewer",
            "text": "Run the repo's own check script before you report.",
            "status": "proposed",
            "proposed_by": "agent",
            "source_thread_id": "thread-1"
          }
        },
        {
          "status": 201,
          "json": {
            "id": "m1",
            "channel_id": null,
            "role": "reviewer",
            "text": "Run the repo's own check script before you report.",
            "status": "approved",
            "proposed_by": "agent",
            "source_thread_id": "thread-1"
          }
        }
      ],
      "steps": [
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
              "protocolVersion": "2025-06-18",
              "capabilities": {},
              "clientInfo": {
                "name": "scenario",
                "version": "0"
              }
            }
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "method": "notifications/initialized"
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "tools/call",
            "params": {
              "name": "remember",
              "arguments": {
                "text": "Run the repo's own check script before you report."
              }
            }
          }
        },
        {
          "waitResponse": 2
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "tools/call",
            "params": {
              "name": "remember",
              "arguments": {
                "text": "Run the repo's own check script before you report.",
                "everywhere": true
              }
            }
          }
        }
      ],
      "expected": {
        "responses": [
          {
            "result": {
              "protocolVersion": "2025-06-18",
              "capabilities": {
                "tools": {
                  "listChanged": true
                }
              },
              "serverInfo": {
                "name": "omni-memory",
                "version": "0.1.0"
              }
            },
            "jsonrpc": "2.0",
            "id": 1
          },
          {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "Proposed for this agent's later threads in #acme only. It waits for Ben to approve it in Settings > Agents."
                }
              ]
            },
            "jsonrpc": "2.0",
            "id": 2
          },
          {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "Kept for this agent's later threads in every channel: Ben lets this agent keep its lessons at once."
                }
              ]
            },
            "jsonrpc": "2.0",
            "id": 3
          }
        ],
        "requests": [
          {
            "method": "POST",
            "url": "/api/crew/reviewer/memory",
            "headers": {
              "authorization": "Bearer tok-1",
              "content-type": "application/json",
              "x-omni-thread": "thread-1"
            },
            "body": {
              "text": "Run the repo's own check script before you report."
            }
          },
          {
            "method": "POST",
            "url": "/api/crew/reviewer/memory",
            "headers": {
              "authorization": "Bearer tok-1",
              "content-type": "application/json",
              "x-omni-thread": "thread-1"
            },
            "body": {
              "text": "Run the repo's own check script before you report.",
              "channel": null
            }
          }
        ],
        "exit": 0
      }
    },
    {
      "name": "the API refuses: its reason is the answer",
      "server": "memory",
      "env": {
        "OMNI_USER": "Ben",
        "OMNI_THREAD_ID": "thread-1",
        "OMNI_TOKEN": "tok-1",
        "OMNI_ROLE": "reviewer"
      },
      "api": [
        {
          "status": 403,
          "json": {
            "error": "Reviewer's memory is read only: only Ben adds to it, in Settings > Agents."
          }
        }
      ],
      "steps": [
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
              "protocolVersion": "2025-06-18",
              "capabilities": {},
              "clientInfo": {
                "name": "scenario",
                "version": "0"
              }
            }
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "method": "notifications/initialized"
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "tools/call",
            "params": {
              "name": "remember",
              "arguments": {
                "text": "Run the repo's own check script before you report.",
                "everywhere": false
              }
            }
          }
        }
      ],
      "expected": {
        "responses": [
          {
            "result": {
              "protocolVersion": "2025-06-18",
              "capabilities": {
                "tools": {
                  "listChanged": true
                }
              },
              "serverInfo": {
                "name": "omni-memory",
                "version": "0.1.0"
              }
            },
            "jsonrpc": "2.0",
            "id": 1
          },
          {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "Reviewer's memory is read only: only Ben adds to it, in Settings > Agents."
                }
              ],
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 2
          }
        ],
        "requests": [
          {
            "method": "POST",
            "url": "/api/crew/reviewer/memory",
            "headers": {
              "authorization": "Bearer tok-1",
              "content-type": "application/json",
              "x-omni-thread": "thread-1"
            },
            "body": {
              "text": "Run the repo's own check script before you report."
            }
          }
        ],
        "exit": 0
      }
    },
    {
