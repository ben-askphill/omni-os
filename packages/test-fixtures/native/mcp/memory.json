      "server": "memory",
      "env": {
        "OMNI_USER": "Ben",
        "OMNI_THREAD_ID": "thread-1",
        "OMNI_TOKEN": "tok-1"
      },
      "steps": [
        {
          "send": {
            "jsonrpc": "2.0",
