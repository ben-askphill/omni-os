            "id": 4
          },
          {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "MCP error -32602: Input validation error: Invalid arguments for tool remember: Invalid input: expected string, received undefined at text"
                }
              ],
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 5
          }
        ],
        "requests": [],
