{
  "scenarios": [
    {
      "name": "protocol: initialize and list the tool",
      "server": "steps",
      "env": {
        "OMNI_USER": "Ben",
        "OMNI_THREAD_ID": "thread-1",
        "OMNI_TOKEN": "tok-1"
      },
      "steps": [
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
              "protocolVersion": "2025-06-18",
              "capabilities": {},
              "clientInfo": {
                "name": "scenario",
                "version": "0"
              }
            }
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "method": "notifications/initialized"
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "tools/list"
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "ping"
          }
        }
      ],
      "expected": {
        "responses": [
          {
            "result": {
              "protocolVersion": "2025-06-18",
              "capabilities": {
                "tools": {
                  "listChanged": true
                }
              },
              "serverInfo": {
                "name": "omni-steps",
                "version": "0.1.0"
              }
            },
            "jsonrpc": "2.0",
            "id": 1
          },
          {
            "result": {
              "tools": [
                {
                  "name": "set_steps",
                  "description": "Show Ben the plan for this task as a short list of steps in the thread, and move the marker as you work. Call it before you start anything with more than one stage, with 3 to 6 steps, then again with the same list each time a step starts or finishes. Write each step as a few plain words Ben would use, like \"Find candidate apps\" or \"Compare prices\": no tool names, file paths, commands or code. Skip it for a quick answer.",
                  "inputSchema": {
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "type": "object",
                    "properties": {
                      "steps": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "Every step in order, the same list each call unless the plan changed. 3 to 6, each a few plain words."
                      },
                      "current": {
                        "description": "The index (from 0) of the step you are on now, 0 when left out. The ones before it are done. Pass the number of steps once all are done.",
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "steps"
                    ]
                  },
                  "execution": {
                    "taskSupport": "forbidden"
                  }
                }
              ]
            },
            "jsonrpc": "2.0",
            "id": 2
          },
          {
            "result": {},
            "jsonrpc": "2.0",
            "id": 3
          }
        ],
        "requests": [],
        "exit": 0
      }
    },
