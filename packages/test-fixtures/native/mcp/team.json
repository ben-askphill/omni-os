                }
              ],
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 2
          },
          {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "MCP error -32602: Input validation error: Invalid arguments for tool message_members: Too small: expected string to have >=1 characters at message"
                }
              ],
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 3
          }
        ],
        "requests": [],
        "exit": 0
      }
    }
  ]
}
