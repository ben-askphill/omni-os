    {
      "name": "the install port proves itself, then gets the token",
      "args": [
        "threads"
      ],
      "address": "port",
      "env": {
        "OMNI_INSTALL_DATA_DIR": "{dir}/data"
      },
      "files": {
        "data/api-token": {
          "text": "install-token\n",
          "mode": "600"
        }
      },
      "proof": "install-token",
      "routes": [
        {
          "method": "GET",
          "path": "/api/threads?limit=20",
          "replies": [
            {
              "json": []
            }
          ]
        }
      ],
      "expected": {
        "stdout": "No threads.\n",
        "stderr": "",
        "exit": 0,
        "requests": [
          {
            "method": "GET",
            "url": "/api/auth/proof?nonce={nonce}",
            "headers": {
              "accept": "*/*"
            },
            "body": null
          },
          {
            "method": "GET",
            "url": "/api/threads?limit=20",
            "headers": {
              "accept": "application/json",
              "authorization": "Bearer install-token"
            },
            "body": null
          }
        ],
        "launched": {}
      }
