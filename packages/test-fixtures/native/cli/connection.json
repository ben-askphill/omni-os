{
  "scenarios": [
    {
      "name": "OMNI_URL that is not http",
      "args": [
        "threads"
      ],
      "address": "none",
      "env": {
        "OMNI_URL": "ftp://example.test",
        "OMNI_TOKEN": "test-token"
      },
      "expected": {
        "stdout": "",
        "stderr": "omni threads: OMNI_URL is not an http(s) address: ftp://example.test\n",
        "exit": 3,
        "requests": [],
        "launched": {}
      }
    },
    {
      "name": "OMNI_URL with a user in it",
      "args": [
        "threads"
      ],
      "address": "none",
      "env": {
        "OMNI_URL": "http://ben@127.0.0.1:1",
        "OMNI_TOKEN": "test-token"
      },
      "expected": {
        "stdout": "",
        "stderr": "omni threads: OMNI_URL is not an http(s) address: http://ben@127.0.0.1:1\n",
        "exit": 3,
        "requests": [],
        "launched": {}
      }
    },
    {
      "name": "OMNI_URL with a query",
      "args": [
        "show",
        "11111111-1111-4111-8111-111111111111"
      ],
      "address": "none",
      "env": {
        "OMNI_URL": " http://127.0.0.1:1/?x=1 "
      },
      "expected": {
        "stdout": "",
        "stderr": "omni show: OMNI_URL is not an http(s) address: http://127.0.0.1:1/?x=1\n",
        "exit": 3,
        "requests": [],
        "launched": {}
      }
    },
    {
      "name": "OMNI_URL with a path prefix and trailing slashes",
      "args": [
        "threads"
      ],
      "address": "none",
      "env": {
        "OMNI_URL": " HTTP://127.0.0.1:{port}/base/omni/// ",
        "OMNI_TOKEN": "test-token"
      },
      "routes": [
        {
          "method": "GET",
          "path": "/base/omni/api/threads?limit=20",
          "replies": [
            {
              "json": []
            }
          ]
        }
      ],
      "expected": {
        "stdout": "No threads.\n",
        "stderr": "",
        "exit": 0,
        "requests": [
          {
            "method": "GET",
            "url": "/base/omni/api/threads?limit=20",
            "headers": {
              "accept": "application/json",
              "authorization": "Bearer test-token"
            },
            "body": null
          }
        ],
        "launched": {}
      }
    },
    {
      "name": "OMNI_URL through localhost",
      "args": [
        "threads"
      ],
      "address": "none",
      "env": {
        "OMNI_URL": "http://localhost:{port}",
        "OMNI_TOKEN": "  spaced-token\n"
      },
      "routes": [
        {
          "method": "GET",
          "path": "/api/threads?limit=20",
          "replies": [
            {
              "json": []
            }
          ]
        }
      ],
      "expected": {
        "stdout": "No threads.\n",
        "stderr": "",
        "exit": 0,
        "requests": [
          {
            "method": "GET",
            "url": "/api/threads?limit=20",
            "headers": {
              "accept": "application/json",
              "authorization": "Bearer spaced-token"
            },
            "body": null
          }
        ],
        "launched": {}
      }
    },
    {
      "name": "no token on OMNI_URL still asks, and the server refuses",
      "args": [
        "threads"
      ],
      "routes": [
        {
          "method": "GET",
          "path": "/api/threads?limit=20",
          "replies": [
            {
              "status": 401,
              "json": {
                "error": "unauthorized"
              }
            }
          ]
        }
      ],
      "expected": {
        "stdout": "",
        "stderr": "omni threads: Omni at {url} refused the token from nowhere: set OMNI_TOKEN, OMNI_TOKEN_FILE or OMNI_DATA_DIR. omni doctor checks it.\n",
        "exit": 3,
        "requests": [
          {
            "method": "GET",
            "url": "/api/threads?limit=20",
            "headers": {
              "accept": "application/json"
            },
            "body": null
          }
        ],
        "launched": {}
      }
    },
    {
      "name": "a blank OMNI_TOKEN is no token",
      "args": [
        "threads"
      ],
      "env": {
        "OMNI_TOKEN": "   "
      },
      "routes": [
        {
          "method": "GET",
          "path": "/api/threads?limit=20",
          "replies": [
            {
              "status": 401,
              "json": {
                "error": "unauthorized"
              }
            }
          ]
        }
      ],
      "expected": {
        "stdout": "",
        "stderr": "omni threads: Omni at {url} refused the token from nowhere: set OMNI_TOKEN, OMNI_TOKEN_FILE or OMNI_DATA_DIR. omni doctor checks it.\n",
        "exit": 3,
        "requests": [
          {
            "method": "GET",
            "url": "/api/threads?limit=20",
            "headers": {
              "accept": "application/json"
            },
            "body": null
          }
        ],
        "launched": {}
      }
    },
    {
      "name": "the token file is read and trimmed",
      "args": [
        "threads"
      ],
      "env": {
        "OMNI_TOKEN_FILE": "{dir}/tok"
      },
      "files": {
        "tok": {
          "text": "\n  file-token  \n\n"
        }
      },
      "routes": [
        {
          "method": "GET",
          "path": "/api/threads?limit=20",
          "replies": [
            {
              "json": []
            }
          ]
        }
      ],
      "expected": {
        "stdout": "No threads.\n",
        "stderr": "",
        "exit": 0,
        "requests": [
          {
            "method": "GET",
            "url": "/api/threads?limit=20",
            "headers": {
              "accept": "application/json",
              "authorization": "Bearer file-token"
            },
            "body": null
          }
        ],
        "launched": {}
      }
    },
    {
      "name": "OMNI_TOKEN wins over the token file",
      "args": [
        "threads"
      ],
      "env": {
        "OMNI_TOKEN": "test-token",
        "OMNI_TOKEN_FILE": "{dir}/tok",
        "OMNI_DATA_DIR": "{dir}/data"
      },
      "files": {
        "tok": {
          "text": "file-token"
        },
        "data/api-token": {
          "text": "data-token"
        }
      },
      "routes": [
        {
          "method": "GET",
          "path": "/api/threads?limit=20",
          "replies": [
            {
              "json": []
            }
          ]
        }
      ],
      "expected": {
        "stdout": "No threads.\n",
        "stderr": "",
        "exit": 0,
        "requests": [
          {
            "method": "GET",
            "url": "/api/threads?limit=20",
            "headers": {
              "accept": "application/json",
              "authorization": "Bearer test-token"
            },
            "body": null
          }
        ],
        "launched": {}
      }
    },
    {
      "name": "OMNI_TOKEN_FILE wins over the data folder",
      "args": [
        "threads"
      ],
      "env": {
        "OMNI_TOKEN_FILE": "{dir}/tok",
        "OMNI_DATA_DIR": "{dir}/data"
      },
      "files": {
        "tok": {
          "text": "file-token"
        },
        "data/api-token": {
          "text": "data-token"
        }
      },
      "routes": [
        {
          "method": "GET",
          "path": "/api/threads?limit=20",
          "replies": [
            {
              "json": []
            }
          ]
        }
      ],
      "expected": {
        "stdout": "No threads.\n",
        "stderr": "",
        "exit": 0,
        "requests": [
          {
            "method": "GET",
            "url": "/api/threads?limit=20",
            "headers": {
              "accept": "application/json",
              "authorization": "Bearer file-token"
            },
            "body": null
          }
        ],
        "launched": {}
      }
    },
    {
      "name": "OMNI_DATA_DIR wins over the install data folder",
      "args": [
        "threads"
      ],
      "env": {
        "OMNI_DATA_DIR": "{dir}/data",
        "OMNI_INSTALL_DATA_DIR": "{dir}/install"
      },
      "files": {
        "data/api-token": {
          "text": "data-token\n"
        },
        "install/api-token": {
          "text": "install-token\n"
        }
      },
      "routes": [
        {
          "method": "GET",
          "path": "/api/threads?limit=20",
          "replies": [
            {
              "json": []
            }
          ]
        }
      ],
      "expected": {
        "stdout": "No threads.\n",
        "stderr": "",
        "exit": 0,
        "requests": [
          {
            "method": "GET",
            "url": "/api/threads?limit=20",
            "headers": {
              "accept": "application/json",
              "authorization": "Bearer data-token"
            },
            "body": null
          }
        ],
        "launched": {}
      }
    },
    {
      "name": "a refused token names the file it came from",
      "args": [
        "threads"
      ],
      "env": {
        "OMNI_TOKEN_FILE": "{dir}/tok"
      },
      "files": {
        "tok": {
          "text": "old"
        }
      },
      "routes": [
        {
          "method": "GET",
          "path": "/api/threads?limit=20",
          "replies": [
            {
              "status": 401,
              "json": {
                "error": "unauthorized"
              }
            }
          ]
        }
      ],
      "expected": {
        "stdout": "",
        "stderr": "omni threads: Omni at {url} refused the token from {dir}/tok (OMNI_TOKEN_FILE). omni doctor checks it.\n",
        "exit": 3,
        "requests": [
          {
            "method": "GET",
            "url": "/api/threads?limit=20",
            "headers": {
              "accept": "application/json",
              "authorization": "Bearer old"
            },
            "body": null
          }
        ],
        "launched": {}
      }
    },
    {
      "name": "a refused token from the environment",
      "args": [
        "threads"
      ],
      "env": {
        "OMNI_TOKEN": "test-token"
      },
      "routes": [
        {
          "method": "GET",
          "path": "/api/threads?limit=20",
          "replies": [
            {
              "status": 401,
              "text": "nope"
            }
          ]
        }
      ],
      "expected": {
        "stdout": "",
        "stderr": "omni threads: Omni at {url} refused the token from OMNI_TOKEN. omni doctor checks it.\n",
        "exit": 3,
        "requests": [
          {
            "method": "GET",
            "url": "/api/threads?limit=20",
            "headers": {
              "accept": "application/json",
              "authorization": "Bearer test-token"
            },
            "body": null
          }
        ],
        "launched": {}
      }
    },
    {
      "name": "nothing listens on OMNI_URL",
      "args": [
        "threads"
      ],
      "address": "closed-url",
      "env": {
        "OMNI_TOKEN": "test-token"
      },
      "expected": {
        "stdout": "",
        "stderr": "omni threads: cannot reach Omni at {url} (fetch failed). Is it running? omni doctor says why not.\n",
        "exit": 3,
        "requests": [],
        "launched": {}
      }
    },
    {
      "name": "the install port with no token sends nothing",
      "args": [
        "threads"
      ],
      "address": "port",
      "expected": {
        "stdout": "",
        "stderr": "omni threads: No API token for {url}: nowhere: set OMNI_TOKEN, OMNI_TOKEN_FILE or OMNI_DATA_DIR. Nothing was sent. omni doctor checks it.\n",
        "exit": 3,
        "requests": [],
        "launched": {}
      }
    },
    {
      "name": "the install port with a missing token file sends nothing",
      "args": [
        "new",
        "hello"
      ],
      "address": "port",
      "env": {
        "OMNI_INSTALL_DATA_DIR": "{dir}/data"
      },
      "expected": {
        "stdout": "",
        "stderr": "omni new: No API token for {url}: {dir}/data/api-token (the install). Nothing was sent. omni doctor checks it.\n",
        "exit": 3,
        "requests": [],
        "launched": {}
      }
    },
    {
      "name": "the install port with an empty token file sends nothing",
      "args": [
        "threads"
      ],
      "address": "port",
      "env": {
        "OMNI_DATA_DIR": "{dir}/data"
      },
      "files": {
        "data/api-token": {
          "text": " \n"
        }
      },
      "expected": {
        "stdout": "",
        "stderr": "omni threads: No API token for {url}: {dir}/data/api-token (OMNI_DATA_DIR). Nothing was sent. omni doctor checks it.\n",
        "exit": 3,
        "requests": [],
        "launched": {}
      }
    },
    {
      "name": "the install port with a missing OMNI_TOKEN_FILE sends nothing",
