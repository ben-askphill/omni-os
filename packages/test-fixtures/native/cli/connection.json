      },
      "expected": {
        "stdout": "",
        "stderr": "omni threads: No API token for http://127.0.0.1:4747: nowhere: set OMNI_TOKEN, OMNI_TOKEN_FILE or OMNI_DATA_DIR. Nothing was sent. omni doctor checks it.\n",
