    {
      "name": "a server with a wrong proof gets nothing",
      "args": [
        "threads"
      ],
      "address": "port",
      "env": {
        "OMNI_INSTALL_DATA_DIR": "{dir}/data"
      },
      "files": {
        "data/api-token": {
          "text": "install-token\n",
          "mode": "600"
        }
      },
      "proof": "wrong",
      "expected": {
        "stdout": "",
        "stderr": "omni threads: {url} answers as Omni, but not as this install's: another install or another program holds the port. The token was not sent. omni doctor says more.\n",
        "exit": 3,
        "requests": [
          {
            "method": "GET",
            "url": "/api/auth/proof?nonce={nonce}",
            "headers": {
              "accept": "*/*"
            },
            "body": null
          }
        ],
        "launched": {}
      }
    },
    {
      "name": "another program on the port: 404",
      "args": [
        "threads"
      ],
      "address": "port",
      "env": {
        "OMNI_INSTALL_DATA_DIR": "{dir}/data"
      },
      "files": {
        "data/api-token": {
          "text": "install-token\n",
          "mode": "600"
        }
      },
      "routes": [
        {
          "method": "GET",
          "path": "/api/auth/proof",
          "prefix": true,
          "replies": [
            {
              "status": 404,
              "text": "Not Found"
            }
          ]
        }
      ],
      "expected": {
        "stdout": "",
        "stderr": "omni threads: {url} answers, but not as Omni (it answered 404, not an Omni proof): another install or another program holds the port. The token was not sent. omni doctor says more.\n",
        "exit": 3,
        "requests": [
          {
            "method": "GET",
            "url": "/api/auth/proof?nonce={nonce}",
            "headers": {
              "accept": "*/*"
            },
            "body": null
          }
        ],
        "launched": {}
      }
