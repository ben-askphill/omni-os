{
  "scenarios": [
    {
      "name": "a refusal with an error",
      "args": [
        "threads"
      ],
      "env": {
        "OMNI_TOKEN": "test-token"
      },
      "routes": [
        {
          "method": "GET",
          "path": "/api/threads?limit=20",
          "replies": [
            {
              "status": 400,
              "json": {
                "error": "No such channel"
              }
            }
          ]
        }
      ],
      "expected": {
        "stdout": "",
        "stderr": "omni threads: No such channel\n",
        "exit": 3,
        "requests": [
          {
            "method": "GET",
            "url": "/api/threads?limit=20",
            "headers": {
              "accept": "application/json",
              "authorization": "Bearer test-token"
            },
            "body": null
          }
        ],
        "launched": {}
      }
    },
