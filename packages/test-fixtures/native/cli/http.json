    {
      "name": "an id is one path segment whatever is in it",
      "args": [
        "open",
        "a b/c?d#e%f'g(h)*i!~é"
      ],
      "env": {
        "OMNI_TOKEN": "test-token"
      },
      "programs": {
        "open": {
          "record": true
        },
        "xdg-open": {
          "record": true
        }
      },
      "routes": [
        {
          "method": "GET",
          "path": "/api/channels/",
          "prefix": true,
          "replies": [
            {
              "json": {
                "id": "a b/c?d#e%f'g(h)*i!~é",
                "name": "Acme",
                "kind": "client",
                "repo_path": null,
                "github_repo": null,
                "use_worktree": 0,
                "base_dir": "/tmp/omni-fixtures/acme",
                "store_domain": null,
                "portal_slug": null,
                "browser_headless": 1,
                "notes": "Fixture",
                "icon": null,
                "design_system_name": null,
                "archived": 0,
                "created_at": "2020-01-01T10:30:00.000Z",
                "avatar_bg": null,
                "avatar_bg_manual": 0,
                "default_harness": null,
                "default_model": null,
                "default_effort": null,
                "worktree_include": null,
                "worktree_shared": null,
                "prompt_open_pr": null,
                "prompt_fix_conflicts": null,
                "prompt_fix_checks": null,
                "scan_opt_out": 0,
                "design_system_size": 0,
                "running": 0,
                "active": [],
                "recent": [],
                "folders": []
              }
            }
          ]
        }
      ],
      "expected": {
        "stdout": "Opened {url}/#/c/a%20b%2Fc%3Fd%23e%25f'g(h)*i!~%C3%A9 in your browser.\n",
        "stderr": "",
        "exit": 0,
        "requests": [
          {
            "method": "GET",
            "url": "/api/channels/a%20b%2Fc%3Fd%23e%25f'g(h)*i!~%C3%A9",
            "headers": {
              "accept": "application/json",
              "authorization": "Bearer test-token"
            },
            "body": null
          }
        ],
        "launched": {
          "browser": [
            "{url}/#/c/a%20b%2Fc%3Fd%23e%25f'g(h)*i!~%C3%A9"
          ]
