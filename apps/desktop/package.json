{
  "name": "@omni/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Omni's desktop app: an Electron window on the Web UI that runs the server itself.",
  "author": "Omni OS",
  "homepage": "https://github.com/ben-askphill/omni-os",
  "main": "dist/main.cjs",
  "desktopName": "omni-os.desktop",
  "exports": {
    "./*": "./*"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "tsx scripts/build.ts && node scripts/ensure-electron.mjs && electron . --dev",
    "start": "tsx scripts/build.ts && node scripts/ensure-electron.mjs && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "stage": "tsx scripts/stage.ts",
    "dist": "tsx scripts/dist.ts",
    "qa": "tsx scripts/qa.ts",
    "dist:linux": "tsx scripts/dist.ts --platform linux --arch x64",
    "dist:mac": "tsx scripts/dist.ts --platform mac",
    "dist:mac:universal": "tsx scripts/dist.ts --platform mac --arch universal"
  },
  "devDependencies": {
    "@electron/osx-sign": "^1.3.3",
    "@omni/shared": "*",
    "@omni/typescript-config": "*",
    "@types/node": "^26.6.2",
    "electron": "44.10.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "playwright": "1.64.0-alpha-1790635538000",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
