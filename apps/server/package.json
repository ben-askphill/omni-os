{
  "name": "@omni/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./*"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --clear-screen=false --exclude '../../data/**' index.ts",
    "start": "NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "import-history": "tsx scripts/import-history.ts",
    "sync:backfill": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/sync-backfill.ts",
    "brain-export": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/brain-export.ts",
    "setup": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/setup.ts",
    "route-eval": "tsx scripts/route-eval/route-eval.ts",
    "route-fit": "tsx scripts/route-eval/fit.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@omni/shared": "*",
    "@playwright/mcp": "0.0.83",
    "@supabase/supabase-js": "^2.117.2",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "croner": "^10.0.1",
    "hono": "^4.13.9",
    "node-pty": "^1.1.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@omni/oauth-broker": "*",
    "@omni/test-fixtures": "*",
    "@omni/typescript-config": "*",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
