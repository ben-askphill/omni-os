{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "node": "24.21.0",
      "env": { "APP_VARIANT": "development", "NODE_OPTIONS": "--max-old-space-size=4096" },
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "image": "macos-tahoe-26.6-xcode-27.1" }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true, "image": "macos-tahoe-26.6-xcode-27.1" }
    },
    "preview": {
      "node": "24.21.0",
      "env": { "APP_VARIANT": "preview", "NODE_OPTIONS": "--max-old-space-size=4096" },
      "environment": "preview",
      "distribution": "internal",
      "ios": { "image": "macos-tahoe-26.6-xcode-27.1" }
    },
    "production": {
      "node": "24.21.0",
      "env": { "APP_VARIANT": "production", "NODE_OPTIONS": "--max-old-space-size=4096" },
      "environment": "production",
      "autoIncrement": true,
      "ios": { "image": "macos-tahoe-26.6-xcode-27.1" }
    }
  },
  "submit": {
    "production": {
      "ios": { "appName": "Omni OS" }
    }
  }
}
